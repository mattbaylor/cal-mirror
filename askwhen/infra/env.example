# Copy to infra/.env on the host and fill in. .env is gitignored; this file is
# the committed record of what has to exist, so a fresh host is not a scavenger
# hunt through compose.yml.
#
#   cp infra/env.example infra/.env && chmod 600 infra/.env
#
# Only these two live in .env. The other two secrets are files under
# infra/secrets/ because compose can mount those into the container without
# them appearing in `docker inspect` — see README.md, "Secrets".

# Where Let's Encrypt sends expiry-failure and deprecation mail. Use an address
# a human reads. This is the only warning before certificates stop renewing.
AW_ACME_EMAIL=

# Cloudflare API token, scoped to Zone:DNS:Edit on the askwhen.me zone ONLY.
# Create it at Cloudflare → My Profile → API Tokens → Create Token → Edit zone
# DNS, and restrict "Zone Resources" to askwhen.me. A global API key here would
# hand a compromised proxy container the ability to rewrite rehosted.us's MX.
CF_API_TOKEN=
