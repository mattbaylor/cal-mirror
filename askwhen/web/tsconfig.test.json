{
  // The tests, under Node rather than the browser. Indexing a fixture by
  // position is what a test does all day, so the unchecked-index rule that
  // earns its keep in src/ is off here.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["es2022", "dom"],
    "types": ["node"],
    "noUncheckedIndexedAccess": false
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
