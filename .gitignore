# Build artifacts
*.app/
*.bin
dist/
# Intermediate iconset (regenerate via assets/icongen.swift)
assets/AppIcon.iconset/

# Local runtime data (never commit real calendar config / logs)
config.json
status.json
*.log

# Swift Package Manager / Xcode
.build/
.swiftpm/
DerivedData/
# .xcodeproj is generated by xcodegen from project.yml
*.xcodeproj/
*.xcworkspace/

# Signing / secrets
*.certSigningRequest
*.p12
*.cer
*.mobileprovision
*.key

# askwhen.me deployment secrets. These paths exist on the host and must never
# exist here: the SMTP submission password, the token pepper (rotating it
# invalidates every write token, unrecoverably), and the DKIM private key —
# which should only ever be on dlvr.rehosted.us in the first place.
# See askwhen/infra/README.md, "Secrets".
/askwhen/infra/.env
/askwhen/infra/secrets/

# Private working notes / session log (never published)
/.notes/

# macOS
.DS_Store

# Agent worktrees — transient, and embedded git repos besides
.claude/worktrees/

# Python bytecode from the repo scripts
__pycache__/
