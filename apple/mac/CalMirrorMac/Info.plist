<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleExecutable</key>
  <string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key>
  <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleName</key>
  <string>$(PRODUCT_NAME)</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <!-- Declared explicitly rather than left to Xcode. Some Xcode versions inject
       these from ASSETCATALOG_COMPILER_APPICON_NAME and some do not (26.6 did,
       26.3 does not), so relying on injection makes the build depend on which
       Xcode ran it. Without CFBundleIconName, App Store Connect rejects the
       build as Invalid Binary (ITMS-90713). -->
  <key>CFBundleIconFile</key>
  <string>AppIcon</string>
  <key>CFBundleIconName</key>
  <string>AppIcon</string>
  <key>CFBundleShortVersionString</key>
  <string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key>
  <string>$(CURRENT_PROJECT_VERSION)</string>
  <key>LSMinimumSystemVersion</key>
  <string>14.0</string>
  <!-- App Store category (required for Mac App Store submission) -->
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.productivity</string>
  <!-- No encryption / no network → export-compliance exempt (auto-answers ASC) -->
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
  <!-- Menu-bar app: no Dock icon -->
  <key>LSUIElement</key>
  <true/>
  <key>NSCalendarsFullAccessUsageDescription</key>
  <string>cal-mirror mirrors events between the calendars you configure.</string>
  <key>NSCalendarsUsageDescription</key>
  <string>cal-mirror mirrors events between the calendars you configure.</string>
</dict>
</plist>
